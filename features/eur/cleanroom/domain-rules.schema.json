{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabelle.at/schemas/domain-rules.schema.json",
  "title": "lokale Ausgangsmappe business-rule domain catalog",
  "description": "Formale Beschreibung von business-rules/domain-rules.json (Clean-Room-Extraktion aus lokale Ausgangsmappe). Global eindeutige Regel-IDs werden zusaetzlich von tools/validate_domain_rules.py geprueft, da Draft 2020-12 keine uniqueItems-Bedingung ueber verschachtelte Arrays definieren kann.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "bereiche"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source", "domain", "method", "author", "supported_years"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "source": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "supported_years": { "$ref": "#/$defs/jahre" }
      }
    },
    "bereiche": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bereich" }
    }
  },
  "$defs": {
    "jahre": {
      "type": "array",
      "description": "Jahresmenge; nur 2024, 2025 und 2026 sind zulaessig.",
      "items": { "type": "integer", "enum": [2024, 2025, 2026] },
      "minItems": 1,
      "uniqueItems": true
    },
    "bereich": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "regeln"],
      "properties": {
        "id": { "type": "string", "pattern": "^B\\d{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "regeln": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/regel" }
        }
      }
    },
    "regel": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "$comment": "Die Eindeutigkeit der id ueber die gesamte Datei wird vom Validierungsskript geprueft.",
      "required": [
        "id", "titel", "regeltyp", "gueltigkeit", "ausloeser", "wirkung",
        "logik", "parameter", "kennzahlen", "quellen", "rechtsgrundlage", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^EUE-\\d{3}$" },
        "titel": { "type": "string", "minLength": 1 },
        "regeltyp": {
          "type": "string",
          "enum": ["Parameter", "Zuordnung", "Berechnung", "Grenzwert", "Wahlrecht", "Validierung", "Abgleich"]
        },
        "gueltigkeit": { "$ref": "#/$defs/gueltigkeit" },
        "ausloeser": { "type": "string", "minLength": 1 },
        "wirkung": { "type": "string", "minLength": 1 },
        "logik": { "type": "string", "minLength": 1 },
        "parameter": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "kennzahlen": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "quellen": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/quelle" }
        },
        "rechtsgrundlage": { "type": "string" },
        "status": { "type": "string", "const": "extrahiert" }
      }
    },
    "gueltigkeit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jahre", "hinweis"],
      "properties": {
        "jahre": { "$ref": "#/$defs/jahre" },
        "hinweis": { "type": "string" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "wert", "einheit", "hinweis"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "wert": { "type": ["string", "number", "boolean"] },
        "einheit": { "type": "string" },
        "jahre": { "$ref": "#/$defs/jahre" },
        "hinweis": { "type": "string" }
      }
    },
    "quelle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blatt", "zelle", "beleg"],
      "properties": {
        "blatt": { "type": "string", "minLength": 1 },
        "zelle": { "type": "string", "minLength": 1 },
        "beleg": { "type": "string", "minLength": 1 }
      }
    }
  }
}
