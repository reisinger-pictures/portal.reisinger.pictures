# ==========================================================================
# portal-e2e — E2E-/Test-Image (aus portal-base abgeleitet)
# --------------------------------------------------------------------------
# Basis: ghcr.io/reisinger-pictures/portal-base:8.5 (PHP 8.5 Prod-Runtime, exiftool,
# ImageMagick, alle App-Extensions; Debian trixie) — identische Runtime wie
# Produktion. Zusätzlich für die E2E-CI (ci.yml, Job `e2e`) vorinstalliert:
#   * Composer (Dist-Binary, wie Prod aus einem digest-gepinnten Image)
#   * Node.js (gepinnte v26.7.0, offizielles Linux-Binary)
#   * pnpm (exakt frontend/package.json#packageManager)
#   * Playwright-Chromium inkl. apt-System-Deps (Version == @playwright/test)
#
# INVARIANTE: Es wird NUR die Umgebung eingebacken — niemals App-Code,
# node_modules/ oder vendor/. Die CI mountet den Workspace und installiert
# Dependencies pro Commit. Browser sind an die Playwright-Version gebunden
# -> Rebuild-Trigger siehe .github/workflows/e2e-image.yml
# (features/infrastructure/28-ci-test-image.md).
# ==========================================================================
FROM ghcr.io/reisinger-pictures/portal-base:8.5@sha256:d762d47c3434434ea5b0dd1ef213e0fa8f12c80b9c3eed314f6f859500a08736

# Build-time package installation needs root. The final runtime identity is
# restored to www-data after all tooling and browser binaries are installed.
USER root

ARG RUNTIME_UID=1000
ARG RUNTIME_GID=1000
RUN groupmod --gid "${RUNTIME_GID}" www-data \
    && usermod --uid "${RUNTIME_UID}" --gid "${RUNTIME_GID}" www-data

# --- Build-Args (Workflow e2e-image.yml extrahiert Repo-Werte) -------------
ARG PLAYWRIGHT_VERSION=1.62.1
ARG NODE_VERSION=26.7.0
ARG NODE_SHA256=982aa24dd8be4c889c6a8ab337ddff3b0896645b20f4239356e80552c16277ee
ARG PNPM_VERSION=11.23.0

# Playwright-Browser liegen global unter /ms-playwright
# (Pfad-Konvention der offiziellen Playwright-Images).
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Composer — statisches Dist-Binary (portabel über Debian-Varianten)
COPY --from=composer:2.10.3@sha256:a5f59b9fd2faf31218632be4809dc6491761085e8064c31dc3b84378c48c248b /usr/bin/composer /usr/bin/composer

# System-Utils: git (actions/checkout), curl (Downloads), xz-utils (Node-Tarball),
# unzip/zip (composer dist-Extraktion)
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        xz-utils \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Node.js — auf eine konkrete Version und deren offiziellen SHA-256-Digest
# festgenagelt. Kein dynamisches Release-Verzeichnis: der Download ist damit
# reproduzierbar und die Integrität wird vor dem Entpacken verifiziert. Der
# CI-Frontend-Job verwendet dieselbe exakte Versionsangabe.
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c --strict - \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm -f /tmp/node.tar.xz \
    && node --version | grep -Fx "v${NODE_VERSION}" \
    && npm --version

# pnpm — exakt die Version aus frontend/package.json (packageManager)
RUN npm install -g "pnpm@${PNPM_VERSION}" && pnpm --version

# Playwright-Chromium inkl. apt-System-Deps — Version == @playwright/test.
# DEBIAN_FRONTEND=noninteractive, da playwright apt intern aufruft.
ENV DEBIAN_FRONTEND=noninteractive
RUN npx --yes "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
    && ls -1 /ms-playwright

USER www-data
