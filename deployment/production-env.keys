# Names referenced by deployment/docker-compose.yml; inventory only, not dotenv.
# Actual values exist only in /opt/stacks/portal-reisinger-pictures/.env on the host.
# Direction: every name here MUST be referenced by the compose file, and
# tests/infrastructure/compose-entrypoint-contract.sh fails when one is not.
# Names the compose file sets as literals (DB_DATABASE, DB_USERNAME, LOG_CHANNEL,
# MEILISEARCH_HOST, FTP_STORAGE_PATH, SFTPGO_*__BINDINGS__*, SFTPGO_DATA_PROVIDER__*,
# XDG_*, AUTH_THROTTLE_LIMIT, DOWNLOAD_THROTTLE, ZIP_DOWNLOAD_THROTTLE) are
# deliberately absent — the host cannot override them. The CHECKOUT_THROTTLE_*
# names are overridable (`${…:-default}`) and therefore listed.
ACCOUNTING_EMAIL
ADMIN_EMAIL
ADMIN_PASSWORD
AI_API_KEY
AI_BASE_URL
AI_ENABLED
AI_MODEL
AI_SESSION_HEADER
AI_SESSION_PREFIX
AI_TYPE
APP_DEBUG
APP_ENV
APP_KEY
APP_URL
CACHE_STORE
CHECKOUT_ENABLED
CHECKOUT_IDEMPOTENCY_TTL_MINUTES
CHECKOUT_NEW_ACCOUNT_HOURS
CHECKOUT_THROTTLE_IP_PER_DAY
CHECKOUT_THROTTLE_IP_PER_HOUR
CHECKOUT_THROTTLE_USER_PER_HOUR
DB_CACHE_CONNECTION
DB_CACHE_LOCK_CONNECTION
DB_CONNECTION
# DB_HOST/DB_PORT are written by the cutover script; Compose defaults them to db_pg/5432.
DB_HOST
DB_PASSWORD
DB_PORT
DB_QUEUE_CONNECTION
DB_QUEUE_RETRY_AFTER
FILE_ENCRYPTION_KEY
FILE_ENCRYPTION_PREVIOUS_KEYS
FRONTEND_URL
FTP_EVENT_SECRET
FTP_EVENT_URL
FTP_PUBLIC_HOST
FTP_UPLOAD_PATH
GALLERY_CLEANUP_GRACE_MONTHS
JWT_SECRET
MAIL_FROM_ADDRESS
MAIL_FROM_NAME
MAIL_HOST
MAIL_MAILER
MAIL_PASSWORD
MAIL_PORT
MAIL_REQUIRE_TLS
MAIL_SCHEME
MAIL_USERNAME
MAKE_API_KEY
MAKE_WEBHOOK_URL
MEILI_MASTER_KEY
MOLLIE_IDEMPOTENCY_WINDOW_MINUTES
MOLLIE_KEY
MOLLIE_MAX_ATTEMPTS
MOLLIE_PAYMENT_METHOD
MOLLIE_PAYMENT_METHODS
MOLLIE_WEBHOOK_URL
PHOTO_STORAGE_PATH
PROXY_DELIVERY_HEADER
QUEUE_CONNECTION
QUEUE_FAILED_DRIVER
QUEUE_WORKER_RESTART_DELAY
QUEUE_WORKER_TIMEOUT
# Registration hardening: safe defaults, MX check opt-in (features/auth/05-registration-hardening.md).
REGISTRATION_BLOCKED_DOMAINS
REGISTRATION_DOMAIN_LIMIT
REGISTRATION_IP_LIMIT
REGISTRATION_MX_CHECK
REGISTRATION_WINDOW_SECONDS
SFTPGO_ADMIN_PASSWORD
SFTPGO_ADMIN_USERNAME
SFTPGO_API_KEY
SFTPGO_BASE_URL
SFTPGO_FTPD_TLS_MODE
SFTPGO_FTPS_PORT
SFTPGO_PASV_PORT_END
SFTPGO_PASV_PORT_START
SFTPGO_SFTP_PORT
TURNSTILE_ALLOWED_HOSTNAMES
TURNSTILE_FAILURE_IP_THRESHOLD_PER_HOUR
TURNSTILE_FAILURE_USER_THRESHOLD_PER_HOUR
TURNSTILE_FAILURE_WINDOW_SECONDS
TURNSTILE_IP_THRESHOLD_PER_HOUR
TURNSTILE_SECRET
TURNSTILE_SITE_KEY
TURNSTILE_USER_THRESHOLD_PER_HOUR
