# ==========================================================================
# Portal — Backend .env.ci (CI/test fixture for GitHub Actions)
# --------------------------------------------------------------------------
# Copied by the CI workflow to `.env` inside the prod portal-base container
# (ghcr.io/reisi007/portal-base:8.5). Contains NO real secrets - the test-only
# JWT_SECRET is a CI signing key, Stripe keys stay empty here (E2E injects
# them via container env from GitHub secrets).
# ==========================================================================

APP_NAME="Portal Reisinger Pictures"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4321

# --- Admin bootstrap (DatabaseSeeder uses these via firstOrCreate) ---------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# --- Accounting / notifications -------------------------------------------
ACCOUNTING_EMAIL=accounting@example.com

# --- Database (CI services match backend/phpunit.xml) ----------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=portal_test_db
DB_USERNAME=portal_user
DB_PASSWORD=admin

# --- Auth / Throttling ----------------------------------------------------
# AUTH_THROTTLE_LIMIT=1000 wie im lokalen .env (Herd): 4 Playwright-Worker
# teilen 127.0.0.1, mit 60/min warf der Login "Too Many Attempts."
AUTH_GUARD=api
AUTH_THROTTLE_LIMIT=1000
# Eigener Bucket für die öffentlichen Model-Registrierungs-Endpunkte: teilt
# sonst mit AUTH_THROTTLE_LIMIT den positionalen sha1(domain|ip)-Key.
MODEL_REGISTRATION_THROTTLE_LIMIT=1000
API_THROTTLE_LIMIT=60
DOWNLOAD_THROTTLE=10
ZIP_DOWNLOAD_THROTTLE=5
# Checkout E2E workers share localhost; focused limiter tests override these values.
CHECKOUT_THROTTLE_USER_PER_HOUR=1000
CHECKOUT_THROTTLE_IP_PER_HOUR=1000
CHECKOUT_THROTTLE_IP_PER_DAY=1000
CHECKOUT_IDEMPOTENCY_TTL_MINUTES=30

# --- JWT (test-only signing key for CI; prod uses `php artisan jwt:secret`) --
JWT_SECRET=2d093d84542d70f133a1689afb5866bed31edd1b520ce8c02ea9d25559fb0834
JWT_TTL=60
JWT_REFRESH_TTL=10080

# --- Mail (mailpit service) ------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=false
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
# Mailpit is unauthenticated in CI; production requires SMTP credentials.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=test@reisinger.pictures
MAIL_FROM_NAME="${APP_NAME}"

# --- Search (Meilisearch service, port 7701) -------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7701
MEILISEARCH_KEY=test_meili_secret

# --- Stripe --------------------------------------------------------------
# Nicht-leere CI-Platzhalter (wie .env.example): die Backend-PHPUnit-Suite
# mockt Stripe-Aufrufe, wirft aber ohne gesetzten Key bereits beim
# StripeClient-Bootstrap "No API key provided". Echte Test-Keys injiziert der
# E2E-Job per Container-Env aus GitHub Secrets (überschreibt diese Werte).
STRIPE_KEY=pk_test_<ci_placeholder>
STRIPE_SECRET=sk_test_<ci_placeholder>
STRIPE_WEBHOOK_SECRET=whsec_<ci_placeholder>
# E2E creates isolated users immediately before checkout; production remains 24h.
STRIPE_CHECKOUT_NEW_ACCOUNT_HOURS=0
STRIPE_CHECKOUT_ENABLED=true
STRIPE_STALE_PAYMENT_INTENT_HOURS=2
STRIPE_CUSTOMERS_ENABLED=false

# --- Cloudflare Turnstile (no credentials in fixture; E2E may inject dummy keys)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=
TURNSTILE_USER_THRESHOLD_PER_HOUR=1000
TURNSTILE_IP_THRESHOLD_PER_HOUR=1000
TURNSTILE_FAILURE_USER_THRESHOLD_PER_HOUR=3
TURNSTILE_FAILURE_IP_THRESHOLD_PER_HOUR=1000
TURNSTILE_FAILURE_WINDOW_SECONDS=3600
# Enables only the exact official Cloudflare dummy response in this CI fixture.
TURNSTILE_ALLOW_DUMMY_TEST_KEYS=true

# --- File / Photo storage --------------------------------------------------
FILESYSTEM_DISK=local
PHOTO_STORAGE_PATH=/var/www/photos
FTP_STORAGE_PATH=ftp

# --- AI provider (optional) ------------------------------------------------
AI_ENABLED=false
AI_TYPE=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o

# --- Queue / Cache / Session ----------------------------------------------
# CI keeps jobs synchronous; production uses the supervised database queue.
QUEUE_CONNECTION=sync
# Queue/cache connection names follow DB_CONNECTION in each CI test context.
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_WORKER_TIMEOUT=60
QUEUE_WORKER_RESTART_DELAY=5
CACHE_STORE=database
SESSION_DRIVER=database

# --- File Encryption (CI/test key; non-production) ---
FILE_ENCRYPTION_KEY=base64:VFRUVFRUVFRUVFRUVFRUVFRUVFRUVFRUVFRUVFRUVFQ=
FILE_ENCRYPTION_PREVIOUS_KEYS=
