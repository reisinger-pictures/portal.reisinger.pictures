# ==========================================================================
# Portal — Backend .env.example (Development Template)
# --------------------------------------------------------------------------
# Copy this file to `.env` (untracked) and fill in your own values.
# Run `php artisan key:generate` to generate APP_KEY.
# Run `php artisan jwt:secret` to generate JWT_SECRET.
# Never commit a real secret. See features/security-env-hardening.md.
# ==========================================================================

APP_NAME="Portal Reisinger Pictures"
APP_ENV=local
APP_KEY=
# Local dev only: verbose error pages are intentional here.
# Production/integration environments MUST set APP_DEBUG=false.
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4321

# --- Admin bootstrap (DatabaseSeeder uses these via firstOrCreate) ---------
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD is set by DatabaseSeeder; override here if desired.

# --- Accounting / notifications -------------------------------------------
ACCOUNTING_EMAIL=accounting@example.com

# --- Database (local dev: SQLite file; see phpunit.xml for test fixtures) ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# --- Auth / Throttling -----------------------------------------------------
AUTH_GUARD=api
AUTH_THROTTLE_LIMIT=60
API_THROTTLE_LIMIT=60
# Dedicated budget for the public model-registration endpoints (own rate-limit
# bucket, separate from the positional auth/invite throttle).
MODEL_REGISTRATION_THROTTLE_LIMIT=10
DOWNLOAD_THROTTLE=10
ZIP_DOWNLOAD_THROTTLE=5
# Dedicated checkout budgets (all requests are counted in addition to API_THROTTLE_LIMIT).
CHECKOUT_THROTTLE_USER_PER_HOUR=5
CHECKOUT_THROTTLE_IP_PER_HOUR=10
CHECKOUT_THROTTLE_IP_PER_DAY=30
CHECKOUT_IDEMPOTENCY_TTL_MINUTES=30

# --- JWT -------------------------------------------------------------------
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=10080

# --- Mail (local dev: Mailpit / Mailhog on port 1025/1026) -----------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Search (Meilisearch) --------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# --- Stripe (TEST keys only in local dev; never commit real keys) ----------
STRIPE_KEY=pk_test_<your_stripe_publishable_key>
STRIPE_SECRET=sk_test_<your_stripe_secret_key>
STRIPE_WEBHOOK_SECRET=whsec_<your_stripe_webhook_signing_secret>
STRIPE_CHECKOUT_NEW_ACCOUNT_HOURS=24
STRIPE_CHECKOUT_ENABLED=true
STRIPE_STALE_PAYMENT_INTENT_HOURS=2
STRIPE_CUSTOMERS_ENABLED=true

# --- Cloudflare Turnstile (optional risk-based checkout protection) ---------
# Both credentials are required to activate server-side verification. Allowed
# hostnames are comma-separated; an empty value falls back to the FRONTEND_URL
# host (or APP_URL when no dedicated frontend URL is configured).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=
TURNSTILE_USER_THRESHOLD_PER_HOUR=3
TURNSTILE_IP_THRESHOLD_PER_HOUR=5
TURNSTILE_FAILURE_USER_THRESHOLD_PER_HOUR=3
TURNSTILE_FAILURE_IP_THRESHOLD_PER_HOUR=5
TURNSTILE_FAILURE_WINDOW_SECONDS=3600
# Test fixtures only; production must leave this false.
TURNSTILE_ALLOW_DUMMY_TEST_KEYS=false

# --- File / Photo storage --------------------------------------------------
FILESYSTEM_DISK=local
PHOTO_STORAGE_PATH=photos
FTP_STORAGE_PATH=ftp

# --- AI provider (optional) ------------------------------------------------
AI_ENABLED=false
AI_TYPE=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
# Session-affinity header for prompt-cache routing (e.g. OpenCode Go expects
# x-opencode-session). Empty value disables the header. The per-batch session
# id sent by the frontend is sanitized, prefixed and clamped to 128 chars.
AI_SESSION_HEADER=x-opencode-session
AI_SESSION_PREFIX=portal-

# --- Queue / Cache / Session ----------------------------------------------
QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=database

# --- File Encryption (AES-256-GCM, ercsctt/laravel-file-encryption) ---
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# Never reuse APP_KEY. Rotation via FILE_ENCRYPTION_PREVIOUS_KEYS (comma-separated).
FILE_ENCRYPTION_KEY=
FILE_ENCRYPTION_PREVIOUS_KEYS=
