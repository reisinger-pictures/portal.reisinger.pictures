{
    "name": "portal-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=26.7.0 <27"
    },
    "packageManager": "pnpm@11.23.0",
    "scripts": {
        "dev": "vite",
        "prebuild": "node scripts/check-turnstile-build.mjs && tsc -b --force && node scripts/check-i18n.mjs",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "lint:e2e": "eslint --no-ignore tests/e2e --max-warnings 0",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test --grep @smoke",
        "test:e2e:grep": "playwright test --grep",
        "test:e2e:failed": "playwright test --last-failed",
        "test:e2e:ui": "playwright test --ui",
        "test:screenshots": "playwright test -c playwright.screenshots.config.ts",
        "test:screenshots:grep": "playwright test -c playwright.screenshots.config.ts --grep",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "lingui:extract": "lingui extract",
        "lingui:compile": "lingui compile",
        "check:i18n": "node scripts/check-i18n.mjs"
    },
    "dependencies": {
        "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
        "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.2",
        "@hookform/resolvers": "^5.9.2",
        "@lingui/babel-plugin-lingui-macro": "^6.12.0",
        "@lingui/core": "^6.12.0",
        "@lingui/react": "^6.12.0",
        "@lingui/vite-plugin": "^6.12.0",
        "@tiptap/core": "~3.34.0",
        "@tiptap/extension-link": "~3.34.0",
        "@tiptap/extension-table": "~3.34.0",
        "@tiptap/extension-table-cell": "~3.34.0",
        "@tiptap/extension-table-header": "~3.34.0",
        "@tiptap/extension-table-row": "~3.34.0",
        "@tiptap/extension-underline": "~3.34.0",
        "@tiptap/react": "~3.34.0",
        "@tiptap/starter-kit": "~3.34.0",
        "dompurify": "^3.4.18",
        "photoswipe": "^5.4.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-helmet-async": "^3.1.0",
        "react-hook-form": "^7.92.0",
        "react-router-dom": "^7.18.5",
        "recharts": "^3.10.1",
        "swr": "^2.5.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8.1.2",
        "@eslint/js": "^10.0.1",
        "@iconify-json/material-symbols": "^1.2.100",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/tailwind4": "^1.2.3",
        "@lingui/cli": "^6.12.0",
        "@lingui/format-po": "^6.12.0",
        "@playwright/test": "^1.65.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.12",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.6.6",
        "@types/pdf-parse": "^1.1.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^4.1.12",
        "babel-plugin-react-compiler": "^1.0.0",
        "daisyui": "^5.8.1",
        "eslint": "^10.15.0",
        "eslint-plugin-lingui": "^0.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "globals": "^17.14.0",
        "jsdom": "^30.0.1",
        "pdf-parse": "^2.4.5",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitest": "^4.1.12"
    }
}
