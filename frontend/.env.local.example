# Stripe publishable key used for local development. Copy this file to
# `.env.local` (untracked, takes precedence over `.env`) and fill in your
# own test key. Never commit a real key.
#
# This precedence is not local-only: Vite loads `.env.local` in every mode,
# so it also outranks `.env` during `pnpm build`. Keep the test
# key here, and put the live key into `frontend/.env.production` — otherwise a
# production build ships this test key (measured 2026-10-15, see `.env.example`).
VITE_STRIPE_PUBLIC_KEY=pk_test_<your_stripe_publishable_key>
# Cloudflare Turnstile site key. Leave empty when Turnstile is not configured.
VITE_TURNSTILE_SITE_KEY=
