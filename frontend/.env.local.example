# Local development overrides. Copy this file to `.env.local` (untracked) and
# fill in your own values. Vite loads `.env.local` in every mode, so it also
# outranks `.env` during `pnpm build` — keep only values a local dev server
# should see here.
#
# Cloudflare Turnstile site key. Leave empty when Turnstile is not configured.
VITE_TURNSTILE_SITE_KEY=
