# Stripe publishable key (live or test). In local development, copy this file
# to `.env` and fill in your own key. Never commit a real key.
#
# Which file wins — Vite loads `.env.local` in every mode, and a
# production build runs mode=production. Precedence, highest first:
#
#   .env.production.local (gitignored)  ← optional local override; highest step
#   .env.production       (gitignored)  ← the live key belongs HERE
#   .env.local            (gitignored)  ← the dev override; beats `.env` in ALL modes
#   .env                  (gitignored)
#
# Consequence, measured on the deployed bundle 2026-10-15: a production build
# embedded `pk_test`, because `.env.local` outranks `.env` — at the time
# `.env.local` carried the test key and `.env` the live one (see `AGENTS.md`
# §8/C4, resolved 2026-07-21). Stripe.js then loads in test mode and cannot
# confirm a live PaymentIntent (`ClientCartView.tsx` passes a live
# `client_secret` to `<Elements>`). A production build therefore requires
# `frontend/.env.production` with the live key; verify it after every build,
# from the repo root:
#
#   grep -rho 'pk_live_[A-Za-z0-9]\{12\}' frontend/dist/assets | head -1
#
VITE_STRIPE_PUBLIC_KEY=pk_test_<your_stripe_publishable_key>
# Cloudflare Turnstile site key. Leave empty when Turnstile is not configured.
VITE_TURNSTILE_SITE_KEY=
