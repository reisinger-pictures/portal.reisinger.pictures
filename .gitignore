# Global
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Frontend
**/node_modules/
frontend/dist/
frontend/.env*
!frontend/.env.example
!frontend/.env.local.example
**/.last-run.json

# Backend
backend/vendor/
backend/public/build/
backend/storage/*.key
backend/.env
backend/.env.local

# Backend - Private storage
backend/storage/app/private/

# Data
/db_data/
/search_data/
/photos/
/ftp/


# Playwright E2E Tests
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# IDE & Build Cache
out/
*.tsbuildinfo

# Core dumps (z.B. QEMU-SIGSEGV bei php artisan serve im php-base-Container)
core
core.*

# AI Test Runner
.playwright-mcp
ai_test_report.txt
ses_*.json+

# Env-Dateien: Default ignorieren, einzelne bewusst getrackte Fixtures explizit erlauben.
.env*
!.env.ci
!.env.example
!.env.local.example
# Verschlüsselte .env-Backups bleiben bewusst lokal und werden nie committed.

# History-rewrite artifacts (contains real secrets — never commit)
.history-replacements.txt
portal-backup-*.bundle
